{% comment %}
  Formulario COD simple: nombre, teléfono, dirección, comuna, región.
  Se envía por fetch (ver assets/cod-landing.js) al servidor de
  storefront/server, que crea la orden en Shopify y dispara Meta CAPI + GA4
  server-side. No usa el checkout nativo de Shopify (a propósito: para COD,
  un formulario corto en la misma página convierte mejor que el checkout
  completo).

  Parámetros esperados (pasados con {% render %}):
    - endpoint: url del servidor de pedidos
    - variant_id: id de variante de Shopify del producto
    - precio: precio de venta (number, en la moneda de la tienda)
    - producto_nombre: string
    - cta_texto: string
{% endcomment %}

<form id="cod-form" class="cod-form" novalidate>
  <div class="cod-form__campo">
    <label for="cod-nombre">Nombre completo</label>
    <input type="text" id="cod-nombre" name="nombre" autocomplete="name" required minlength="3" />
  </div>

  <div class="cod-form__campo">
    <label for="cod-telefono">Teléfono (con código de área, sin +56)</label>
    <input type="tel" id="cod-telefono" name="telefono" autocomplete="tel" inputmode="numeric"
      placeholder="9 1234 5678" required minlength="8" />
  </div>

  <div class="cod-form__campo">
    <label for="cod-direccion">Dirección (calle, número, depto/casa)</label>
    <input type="text" id="cod-direccion" name="direccion" autocomplete="street-address" required minlength="5" />
  </div>

  <div class="cod-form__campo cod-form__campo--mitad">
    <label for="cod-comuna">Comuna</label>
    <input type="text" id="cod-comuna" name="comuna" autocomplete="address-level2" required minlength="2" />
  </div>

  <div class="cod-form__campo cod-form__campo--mitad">
    <label for="cod-region">Región</label>
    <select id="cod-region" name="region" required>
      <option value="" disabled selected>Selecciona tu región</option>
      <option>Arica y Parinacota</option>
      <option>Tarapacá</option>
      <option>Antofagasta</option>
      <option>Atacama</option>
      <option>Coquimbo</option>
      <option>Valparaíso</option>
      <option>Metropolitana de Santiago</option>
      <option>Libertador General Bernardo O'Higgins</option>
      <option>Maule</option>
      <option>Ñuble</option>
      <option>Biobío</option>
      <option>La Araucanía</option>
      <option>Los Ríos</option>
      <option>Los Lagos</option>
      <option>Aysén del General Carlos Ibáñez del Campo</option>
      <option>Magallanes y de la Antártica Chilena</option>
    </select>
  </div>

  {% comment %} Campos ocultos: contexto de producto + tracking {% endcomment %}
  <input type="hidden" name="varianteId" value="{{ variant_id }}" />
  <input type="hidden" name="productoNombre" value="{{ producto_nombre }}" />
  <input type="hidden" name="precio" value="{{ precio }}" />
  <input type="hidden" name="eventId" value="" />
  <input type="hidden" name="fbp" value="" />
  <input type="hidden" name="fbc" value="" />
  <input type="hidden" name="ga4ClientId" value="" />
  <input type="hidden" name="urlPagina" value="" />

  <p class="cod-form__legal">
    Al confirmar aceptas nuestra
    <a href="/policies/privacy-policy" target="_blank" rel="noopener">Política de Privacidad</a>
    y nuestra
    <a href="/policies/refund-policy" target="_blank" rel="noopener">Política de Cambios y Retracto</a>.
  </p>

  <button type="submit" class="cod-form__boton" data-endpoint="{{ endpoint }}">
    {{ cta_texto | default: "Pedir ahora — pago contra entrega" }}
  </button>

  <p class="cod-form__estado" id="cod-form-estado" role="status" aria-live="polite"></p>
</form>
