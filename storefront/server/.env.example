# Copia este archivo a .env y completa los valores.
# Ver storefront/server/README.md para saber EXACTAMENTE dónde obtener cada uno.

# Puerto en el que escucha el servidor
PORT=3000

# Origen exacto de tu tienda Shopify (para permitir el POST desde el navegador vía CORS)
# Ej: https://tu-tienda.cl  o  https://tu-tienda.myshopify.com
ALLOWED_ORIGIN=

# --- Shopify Admin API (app personalizada) ---
# Ej: tu-tienda.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Token de acceso Admin API de tu app personalizada (empieza con shpat_)
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Versión de la Admin API. Revisa la versión estable vigente en shopify.dev/docs/api/admin
SHOPIFY_API_VERSION=2025-01

# --- Meta (Facebook/Instagram) Conversions API ---
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Opcional: código de prueba de Events Manager (para testear sin contaminar datos reales)
META_TEST_EVENT_CODE=

# --- GA4 Measurement Protocol ---
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# --- Producto activo (debe coincidir con config/producto-actual.json) ---
# Fuente de verdad del precio/variante para crear la orden: NUNCA se confía
# en el precio que mande el formulario del navegador.
PRODUCTO_NOMBRE="Compresor Digital Inflador de Aire"
PRODUCTO_PRECIO=29990
PRODUCTO_VARIANT_ID=
